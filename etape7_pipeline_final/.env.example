# Copiez ce fichier vers .env (même dossier) et remplissez vos identifiants.

# Supabase (obligatoire — voir README.md)
SUPABASE_URL=
SUPABASE_KEY=

# AWSolutions (optionnel — voir sources/aws_solutions.py). Sans ces deux
# variables, la source AWS échoue proprement (encadré rouge sur le site),
# le reste du pipeline continue normalement.
EMAIL_AWS=
MOT_DE_PASSE_AWS=

# e-marchespublics.com (optionnel — voir sources/e_marche.py). Même
# principe que AWSolutions : sans ces deux variables, seule cette source
# échoue proprement, le reste du pipeline continue normalement.
EMAIL_EMP=
MOT_DE_PASSE_EMP=
